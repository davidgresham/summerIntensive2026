install.packages("ggplot2")
install.packages("tidyverse")
install.packages("readr")
library(readr)
dog_weights <- read_csv("data/dog_weights.csv")
head(dog_weights)
library(tidyverse)
library(tidyverse)
ggplot(dog_weights, mapping = aes(y = dog_weight, x = dog_type)) +
geom_boxplot()
library(tidyverse)
ggplot(dog_weights, mapping = aes(y = dog_weight, x = dog_type)) +
geom_boxplot() +
geom_jitter()
library(tidyverse)
ggplot(dog_weights, mapping = aes(y = dog_weight, x = dog_type)) +
geom_boxplot() +
geom_jitter(col = "red")
library(tidyverse)
ggplot(dog_weights, mapping = aes(y = dog_weight, x = dog_type)) +
geom_boxplot() +
geom_jitter(col = "red", alpha = 0.4)
